        licence: "OFL-1.1";
        weight: "200 800";
    }
    font mono {
        family: "JetBrains Mono";
        file: "fonts/jetbrains-mono-latin-wght-normal.woff2";
        sha256: "18be452724bfdc236c074ca94a249a7f41a86752c7d04ab258ce9ed5651f6a7e";
        licence: "OFL-1.1";
        weight: "100 800";
    }
    font hand {
        family: "Caveat";
        file: "fonts/caveat-latin-wght-normal.woff2";
        sha256: "891951df5e8b5b0f0bc760d31375405e795c666b5add70437de12d4a6482b33f";
        licence: "OFL-1.1";
        weight: "400 700";
    }
}

