        accent: "#6ea3ee"; accent_fg: "#0a1220"; accent_soft: "#14233a"; good: "#4fd1a5"; warn: "#f1c577"; warn_bg: "#1c1810";
        warn_line: "#7e6126"; bad: "#ff7a72"; bad_bg: "#2a1413"; code_bg: "#12151a"; code_fg: "#d6dde8";
