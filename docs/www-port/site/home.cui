// docs/www-port/site/home.cui — the home page of cancho-www (alpibrusl/cancho-www at 4288356), written in cancho-ui. Port, step 2 (PR B1): the page's
// content, head, theme, fonts, pictures, videos and data. What is not here yet (the hero scene, the cairns, the three card drawings, the authority
// animation and the ecosystem map: islands, PR B2) and what was dropped or changed on purpose (docs/www-port/dropped.md) are listed, not hidden.
// The text of the page is the page's; the lists the page's Python generator writes from data/ecosystem.json are `For`s over that file, written out at build.

data Ecosystem { file: "data/ecosystem.json" sha256: "a52c94388823335830af426be6c9163b9cf7e78f6b76eb333f2ef265b488fd5f"; }

page {
    title: "cancho: tools built for agents, not adapted from humans";
    lang: "en";
    description: "cancho is a programming language and toolchain for software built by AI agents and checked by machines. Programs declare what they can do, dependencies have stable identities, and the compiler returns structured evidence other tools can read and check. Pre-1.0.";
    share_description: "Trust without comprehension: a language where what code may do is in its type, and the ecosystem built with it.";
    canonical: "https://cancho.dev/";
    image: "og.png" alt: "cancho: Tools built for agents. Trust without comprehension.";
    icon: "logo-mark.png";
    touch_icon: "logo.png";
    alternate: "agents.md" title: "cancho, as an agent reads it";
    alternate: "data/ecosystem.json" title: "The cancho ecosystem as data";
    skip_link: "Skip to content";
}

theme {
    light {
        bg: "#f7f4eb"; fg: "#121417"; muted: "#4f545b"; line: "#e2ddd0"; surface: "#ffffff"; soft: "#efece1"; ink: "#16283b";
        accent: "#185fa5"; accent_fg: "#ffffff"; accent_soft: "#ebf3fc"; good: "#0f7b5f"; warn: "#8a4b0a"; warn_bg: "#f9efd9";
        warn_line: "#d9a441"; bad: "#b91c1c"; bad_bg: "#fdeceb"; code_bg: "#12151a"; code_fg: "#d6dde8";
    }
