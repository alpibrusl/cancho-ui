[3.715918, "o", "\r\n"]
[3.7289, "o", "// Open a file.\r\nimport std.io;\r\n\r\nfn main(world: World) -> [] int {\r\n    let Split { io, ffi, fs, heap, args } = split(world);\r\n    release(args);\r\n    release(ffi);\r\n    release(heap);\r\n    var status = 1;\r\n    let tmp = narrow(fs, \"/tmp\");\r\n    borrow tmp as &c in {\r\n        match open_read(c, \"/tmp/notes.txt\") {\r\n            Opened::Ok(f) => {\r\n                status = 0;\r\n            }\r\n            Opened::Failed(e) => {\r\n            }\r\n        }\r\n    }\r\n    release(tmp);\r\n    borrow mut io as &!i in {\r\n        if status == 0 {\r\n            io.write_all(i, \"opened it, closed it\\n\");\r\n        } else {\r\n            io.write_all(i, \"no such file\\n\");\r\n        }\r\n    }\r\n    release(io);\r\n    return status;\r\n}\r\n"]
