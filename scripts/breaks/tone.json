    {
      "name": "a text of only spaces keeps its tone",
      "file": "crates/cancho-ui-codegen-web/src/view.rs",
      "from": "\"{0}if (!{1}.textContent.trim()) {{ {1}.removeAttribute('data-tone'); }}\\n\",",
      "to": "\"{0}if (!{1}.textContent) {{ {1}.removeAttribute('data-tone'); }}\\n\","
    },
    {
      "name": "the tone is dropped when there is a message",
