      "from": "            if bindings.iter().any(|b| b.key == \"tone\") {\n                out.push_str(&format!(\n                    \"{0}if (!{1}.textContent.trim())",
      "to": "            if false && bindings.iter().any(|b| b.key == \"tone\") {\n                out.push_str(&format!(\n                    \"{0}if (!{1}.textContent.trim())"
