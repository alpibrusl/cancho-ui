      "from": "\"{0}if (!{1}.textContent.trim()) {{ {1}.removeAttribute('data-tone'); }}\\n\",",
      "to": "\"{0}if (!{1}.textContent.trim()) {{ {1}.removeAttribute('role'); {1}.removeAttribute('data-tone'); }}\\n\","
    }
  ]
