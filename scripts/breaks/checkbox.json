      "from": ".cui-check { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; min-width: 44px; }",
      "to": ".cui-check { display: flex; align-items: center; gap: 0.5rem; }"
    },
    {
      "name": "a Checkbox is not focusable to the focus helper",
      "file": "crates/cancho-ui-ir/src/ir.rs",
      "from": "                | IrElementKind::Checkbox\n                | IrElementKind::Select\n",
      "to": "                | IrElementKind::Select\n"
    },
    {
      "name": "a Checkbox without on: is accepted",
      "file": "crates/cancho-ui-ir/src/controls.rs",
      "from": "        if !bindings.iter().any(|b| b.key == key) {\n            return Err(LowerError::ControlRefused {\n                code: \"checkbox-incomplete\",",
      "to": "        if key != \"on\" && !bindings.iter().any(|b| b.key == key) {\n            return Err(LowerError::ControlRefused {\n                code: \"checkbox-incomplete\","
    },
    {
      "name": "checked accepts any state field",
      "file": "crates/cancho-ui-ir/src/controls.rs",
      "from": "                .any(|f| &f.name == name && f.ty == IrType::Bool) =>\n        {\n            Ok(())\n        }\n        _ => Err(LowerError::ControlRefused {\n            code: \"checked-binding-invalid\",",
      "to": "                .any(|f| &f.name == name) =>\n        {\n            Ok(())\n        }\n        _ => Err(LowerError::ControlRefused {\n            code: \"checked-binding-invalid\","
    },
    {
      "name": "a Checkbox takes any key",
      "file": "crates/cancho-ui-ir/src/controls.rs",
      "from": "    if matches!(kind, IrElementKind::Checkbox)\n        && !CHECKBOX_KEYS.contains(&b.key.as_str())",
