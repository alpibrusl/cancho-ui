      "from": "{0}{1}_field.appendChild({1});\\n{0}{1}_field.appendChild(document.createTextNode({2}));\\n{0}{3}.appendChild({1}_field);\\n",
      "to": "{0}{1}_field.appendChild({1});\\n{0}{3}.appendChild({1}_field);\\n{0}{3}.appendChild(document.createTextNode({2}));\\n"
    },
    {
      "name": "the stylesheet makes the box itself 44 px (no label target)",
