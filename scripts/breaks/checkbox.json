{
  "checks": [
    { "name": "cargo test checkbox", "argv": ["cargo", "test", "--quiet", "-p", "cancho-ui", "--test", "checkbox"] },
    { "name": "check-checkbox.js", "argv": ["node", "scripts/check-checkbox.js"] },
    { "name": "check-tickets.js", "argv": ["node", "scripts/check-tickets.js"] }
  ],
  "breaks": [
    {
      "name": "the box is not drawn from the Bool",
      "file": "crates/cancho-ui-codegen-web/src/view.rs",
      "from": "\"{0}{1}.checked = !!{2}{3};\\n\",",
      "to": "\"{0}{1}.dataset.checked = !!{2}{3};\\n\","
    },
    {
      "name": "the handler gets the click, not the state",
      "file": "crates/cancho-ui-codegen-web/src/view.rs",
      "from": "function (e) {{ __on_{2}(e.target.checked); }}",
      "to": "function (e) {{ __on_{2}(!e.target.checked); }}"
    },
    {
      "name": "the change is not wired",
      "file": "crates/cancho-ui-codegen-web/src/view.rs",
      "from": "addEventListener('change', function (e) {{ __on_{2}(e.target.checked); }});",
      "to": "addEventListener('dblclick', function (e) {{ __on_{2}(e.target.checked); }});"
    },
    {
      "name": "the text is not inside the label (a click on it does nothing)",
