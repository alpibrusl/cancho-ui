    },
    {
      "name": "the description bound is exclusive",
      "file": "crates/cancho-ui-ir/src/page.rs",
      "from": "if text.chars().count() > DESCRIPTION_MAX {",
      "to": "if text.chars().count() >= DESCRIPTION_MAX {"
    },
    {
      "name": "a one-letter language is a language",
