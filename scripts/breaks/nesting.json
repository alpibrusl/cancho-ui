{
  "checks": [
    {
      "name": "cargo test nesting",
      "argv": [
        "cargo",
        "test",
        "--quiet",
        "-p",
        "cancho-ui",
        "--test",
        "nesting"
      ]
    }
  ],
  "breaks": [
    {
      "name": "expressions are not counted",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "    fn parse_unary(&mut self) -> Result<Expr, ParseError> {\n        self.enter_nest()?;",
      "to": "    fn parse_unary(&mut self) -> Result<Expr, ParseError> {\n        self.nest += 0;"
    },
    {
      "name": "a chain of operators is not counted",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "            if self.nest + links > MAX_NEST_DEPTH {",
      "to": "            if false && self.nest + links > MAX_NEST_DEPTH {"
    },
    {
      "name": "view elements are not counted",
      "file": "crates/cancho-ui-syntax/src/parser/view.rs",
      "from": "    fn parse_element_node(&mut self) -> Result<ViewNode, ParseError> {\n        self.enter_nest()?;",
      "to": "    fn parse_element_node(&mut self) -> Result<ViewNode, ParseError> {\n        self.nest += 0;"
    },
    {
      "name": "types are not counted",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "    fn parse_type(&mut self) -> Result<Type, ParseError> {\n        self.enter_nest()?;",
      "to": "    fn parse_type(&mut self) -> Result<Type, ParseError> {\n        self.nest += 0;"
    },
    {
      "name": "else if is not counted",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "                self.enter_nest()?;\n                let nested = self.parse_if();",
      "to": "                let nested = self.parse_if();"
    },
    {
      "name": "the limit is 1000",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "pub const MAX_NEST_DEPTH: usize = 32;",
      "to": "pub const MAX_NEST_DEPTH: usize = 1000;"
    },
    {
      "name": "an interpolation starts counting again",
      "file": "crates/cancho-ui-syntax/src/parser.rs",
      "from": "                depth: 0,\n                nest,\n            };",
      "to": "                depth: 0,\n                nest: 0,\n            };"
    },
    {
