      "to": "if false && out.iter().any(|o| o.name == d.name) {"
    },
    {
      "name": "a changed file's hash is not in the diff",
      "file": "crates/cancho-ui-ir/src/data.rs",
      "from": "out.push((format!(\"{}.sha256\", d.name), d.sha256.clone()));",
      "to": ""
    },
    {
      "name": "the data is not counted by diff",
      "file": "crates/cancho-ui-diff/src/lib.rs",
      "from": "        + page.len()\n        + data.len()\n",
      "to": "        + page.len()\n"
    },
    {
      "name": "a link from the data is not parsed",
      "file": "crates/cancho-ui-syntax/src/parser/view.rs",
      "from": "(\"to\", ElementKind::Link | ElementKind::CountUp)",
      "to": "(\"to\", ElementKind::CountUp)"
    },
    {
      "name": "effects does not list the file",
      "file": "crates/cancho-ui/src/main.rs",
      "from": ".filter(|d| d.components.contains(&comp.name))",
      "to": ".filter(|_| false)"
    },
    {
      "name": "a link out of the directory is the file",
      "file": "crates/cancho-ui/src/data.rs",
      "from": "let Some(meta) = meta.filter(|_| inside) else {",
      "to": "let Some(meta) = meta.filter(|_| true) else {"
    },
    {
      "name": "a whole number of the data is written with a decimal point",
      "file": "crates/cancho-ui/src/data.rs",
      "from": "Some(format!(\"{}\", *n as i64))",
      "to": "Some(format!(\"{n:.1}\"))"
    },
    {
      "name": "join is not a closed expression",
      "file": "crates/cancho-ui/src/data.rs",
      "from": "    \"json.items\",\n    \"filter\",\n",
      "to": "    \"json.items\",\n"
    },
    {
      "name": "the bare file name is the empty directory",
      "file": "crates/cancho-ui/src/pipeline.rs",
      "from": "Some(d) if !d.as_os_str().is_empty() => d,",
      "to": "Some(d) => d,"
    }
  ]
}