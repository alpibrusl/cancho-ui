// examples/cards/cards.cui — Tier 12 composition, Tier 13
// constant properties, Tier 14 dynamic properties. `Page`
// instantiates `HelloCard` several times; each instance is its
// own unit — separate state, separate handlers — mounted into
// its own wrapper element. `title: "..."` is a constant
// property; inside a `For`, `title: t` is a *dynamic* property
// read from the enclosing binding (here, one card per list
// element) — evaluated on every parent render. Non-constant
// values outside a local source, unknown keys, duplicate keys,
// and type mismatches are all compile-time refusals.
//
// A cycle like `HelloCard` containing `HelloCard` is refused at
// compile time (`component-cycle`) because the emitted mount
// would recurse forever.

component HelloCard {
    state title: String = "card";
    state count: Int = 0;

    on Inc {
        count = count + 1;
    }

    view {
        Column {
            Text {
                role: heading
                "{title}"
            }
            Text { "count: {count}" }
            Button { label: "card +" on: Inc }
        }
    }
}

component Page {
    state more: List[String] = ["extra A", "extra B"];

    view {
        Column {
            Text {
                role: heading
                "page"
            }
            HelloCard { title: "first card" }
            HelloCard { title: "second card" }
            For {
                over: more
                as: t
                HelloCard { title: t }
            }
        }
    }
}