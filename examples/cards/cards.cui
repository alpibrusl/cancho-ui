// examples/cards/cards.cui — Tier 12 composition plus Tier 13
// properties. `Page` instantiates `HelloCard` twice; each
// instance is its own unit — separate state, separate handlers —
// mounted into its own wrapper element. `title: "..."` is a
// *property*: a constant initial value for the child's String
// state field, so the two cards say different things while their
// counts still advance independently. Non-constant values,
// unknown keys, duplicate keys, and type mismatches are all
// compile-time refusals.
//
// A cycle like `HelloCard` containing `HelloCard` is refused at
// compile time (`component-cycle`) because the emitted mount
// would recurse forever.

component HelloCard {
    state title: String = "card";
    state count: Int = 0;

    on Inc {
        count = count + 1;
    }

    view {
        Column {
            Text {
                role: heading
                "{title}"
            }
            Text { "count: {count}" }
            Button { label: "card +" on: Inc }
        }
    }
}

component Page {
    view {
        Column {
            Text {
                role: heading
                "page"
            }
            HelloCard { title: "first card" }
            HelloCard { title: "second card" }
        }
    }
}