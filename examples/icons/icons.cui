// examples/icons/icons.cui — the `Icon` element (docs/structure.md 12.0q): the 118 line icons the compiler carries (Lucide, ISC; see THIRD_PARTY.md), each an inline SVG
// drawn from the vendored files: no <img>, no request, no data: address. Every stroke is currentColor, so an icon takes the text colour of what holds it: the pressed key
// below turns the accent, a disabled one fades with its text, and the page in dark mode needs no second set. A name outside the set is refused when the page is built
// (`icon-unknown`, with the nearest names); an icon outside a labelled key says what it is (`label:`) or that words beside it do (`decorative: true`).

component Icons {
    state muted: Bool = false;
    state saved: Bool = false;

    on Mute { muted = !muted; }
    on Save { saved = true; }

    view {
        Column {
            Main {
                id: "main"
                Section {
                    id: "icons"
                    Heading { level: 1 "Icons" }
                    Rich { "A closed set, compiled into the page. The colour is the text colour; the stroke is 2, with round ends." }
                    Heading { level: 2 "Sizes" }
                    Row {
                        gap: 3
                        Icon { label: "A small bell" name: "bell" size: "small" }
                        Icon { label: "A medium bell, the default" name: "bell" }
                        Icon { label: "A large bell" name: "bell" size: "large" }
                    }
                    Heading { level: 2 "In keys" }
                    Row {
                        keys: true
                        Button { label: "Mute: no notifications" on: Mute pressed: muted Icon { name: "bell-off" } Text { "Mute" } }
                        Button { label: "Settings" on: Save Icon { name: "settings" } Text { "Settings" } }
                        Button { label: "Search" on: Save disabled: true Icon { name: "search" } Text { "Search" } }
                    }
                    Row {
                        Button { label: "Save" icon: "save" on: Save }
                        Button { label: "Delete" icon: "trash" on: Save }
                    }
                    If {
                        when: saved
                        Row { gap: 1 Icon { name: "circle-check" decorative: true } Text { "Saved" } }
                    }
                    Heading { level: 2 "All 118" }
                    Grid {
                        min: 9
                        gap: 2
                        Row { gap: 1 Icon { name: "archive" decorative: true } Text { style: "note" "archive" } }
                        Row { gap: 1 Icon { name: "arrow-down" decorative: true } Text { style: "note" "arrow-down" } }
                        Row { gap: 1 Icon { name: "arrow-left" decorative: true } Text { style: "note" "arrow-left" } }
                        Row { gap: 1 Icon { name: "arrow-right" decorative: true } Text { style: "note" "arrow-right" } }
                        Row { gap: 1 Icon { name: "arrow-up" decorative: true } Text { style: "note" "arrow-up" } }
                        Row { gap: 1 Icon { name: "baby" decorative: true } Text { style: "note" "baby" } }
                        Row { gap: 1 Icon { name: "ban" decorative: true } Text { style: "note" "ban" } }
                        Row { gap: 1 Icon { name: "bean" decorative: true } Text { style: "note" "bean" } }
                        Row { gap: 1 Icon { name: "bed" decorative: true } Text { style: "note" "bed" } }
                        Row { gap: 1 Icon { name: "bell" decorative: true } Text { style: "note" "bell" } }
                        Row { gap: 1 Icon { name: "bell-off" decorative: true } Text { style: "note" "bell-off" } }
                        Row { gap: 1 Icon { name: "calendar" decorative: true } Text { style: "note" "calendar" } }
                        Row { gap: 1 Icon { name: "calendar-check" decorative: true } Text { style: "note" "calendar-check" } }
                        Row { gap: 1 Icon { name: "calendar-days" decorative: true } Text { style: "note" "calendar-days" } }
                        Row { gap: 1 Icon { name: "camera" decorative: true } Text { style: "note" "camera" } }
                        Row { gap: 1 Icon { name: "car" decorative: true } Text { style: "note" "car" } }
                        Row { gap: 1 Icon { name: "check" decorative: true } Text { style: "note" "check" } }
                        Row { gap: 1 Icon { name: "check-check" decorative: true } Text { style: "note" "check-check" } }
                        Row { gap: 1 Icon { name: "chevron-left" decorative: true } Text { style: "note" "chevron-left" } }
                        Row { gap: 1 Icon { name: "chevron-right" decorative: true } Text { style: "note" "chevron-right" } }
                        Row { gap: 1 Icon { name: "circle-check" decorative: true } Text { style: "note" "circle-check" } }
                        Row { gap: 1 Icon { name: "circle-question-mark" decorative: true } Text { style: "note" "circle-question-mark" } }
                        Row { gap: 1 Icon { name: "circle-x" decorative: true } Text { style: "note" "circle-x" } }
