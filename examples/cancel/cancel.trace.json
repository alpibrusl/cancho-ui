    { "advance": 399, "state": { "status": "loading" }, "expect": { "fired": [] } },
    { "advance": 1,
      "state": { "status": "cancelled", "r": { "Cancelled": null } },
      "expect": { "fired": [ { "request": 1, "delivered": "Cancelled", "outcome": "completed" } ] } }
  ]
}
