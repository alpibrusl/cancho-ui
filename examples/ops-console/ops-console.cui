// examples/ops-console/ops-console.cui — a machine list for a plant-floor operator (docs/ops-console.md).
//
// The first page that uses the builtins of the last weeks TOGETHER, instead of one per test page: it reads `api/machines`,
// a text with one JSON record per line (`lines`), filters it as the operator types (`contains`, `lower`), orders it by a
// number held in the record (`sort`, `num`), pages it (`take`, `skip`), refreshes by itself (`start`, `every`), and sends
// a change with `net.post` (the capability `NetworkWrite`, which `Network` does not grant).

component OpsConsole {
    requires Network;
    requires NetworkWrite;
    requires Storage("ops-console");
    requires Clock;

    state rows: List[String] = [];
    state shown: List[String] = [];
    state paged: List[String] = [];
    state q: String = "";
    state dir: Int = 1;
    state page: Int = 0;
    state pages: Int = 1;
    state note: String = "not loaded";
    state last: String = "";
    state saved_at: Int = 0;
    state saved: Bool = true;
    state now: Int = 0;
    state age: String = "";
    state r: Result[String, String] = Ok("");
    state target: String = "";
    state setpoint: String = "";
    state sent: Result[String, String] = Ok("");
    state outcome: String = "nothing sent";
    state sending: Bool = false;
    state code: String = "";
    state tone: String = "";

    start Refresh;
    every 5000 Refresh;

    on Refresh {
        note = "loading";
        last = storage.get("machines", last);
        saved_at = num(storage.get("machines_at", ""), 0);
        r = await(net.get("api/machines"));
        now = clock.now();
        last = match r {
            Ok(text) => { text }
            Err(_) => { last }
            Cancelled => { last }
        };
        saved_at = match r {
            Ok(_) => { now }
            Err(_) => { saved_at }
            Cancelled => { saved_at }
        };
        saved = storage.set("machines", last);
        saved = storage.set("machines_at", "" + saved_at) && saved;
        age = if saved_at == 0 { "at an unknown time" } else if now - saved_at < 60000 { "less than a minute ago" } else { floor((now - saved_at) / 60000) + " min ago" };
        note = match r {
            Ok(_) => { if saved { "updated" } else { "updated (not saved: this device's storage is full)" } }
            Err(e) => { if len(last) > 0 { "error: " + e + " (showing the list saved " + age + ")" } else { "error: " + e + " (nothing is saved yet: try again when online)" } }
            Cancelled => { "cancelled" }
        };
        rows = filter(lines(last), x => len(json.get(x, "id", "")) > 0);
        shown = sort(filter(rows, x => contains(lower(json.get(x, "name", "")), lower(q))), x => dir * num(json.get(x, "temp", ""), dir * 1000000000));
        pages = max(ceil(len(shown) / 5), 1);
        page = if page * 5 < len(shown) { page } else { 0 };
        paged = take(skip(shown, page * 5), 5);
    }

    on Query(v) {
        q = v;
        page = 0;
        shown = sort(filter(rows, x => contains(lower(json.get(x, "name", "")), lower(q))), x => dir * num(json.get(x, "temp", ""), dir * 1000000000));
        pages = max(ceil(len(shown) / 5), 1);
        paged = take(skip(shown, page * 5), 5);
    }

    on Flip {
        dir = 0 - dir;
        page = 0;
        shown = sort(filter(rows, x => contains(lower(json.get(x, "name", "")), lower(q))), x => dir * num(json.get(x, "temp", ""), dir * 1000000000));
        pages = max(ceil(len(shown) / 5), 1);
        paged = take(skip(shown, page * 5), 5);
    }

    on Next {
        page = min(page + 1, pages - 1);
        paged = take(skip(shown, page * 5), 5);
    }

    on Prev {
        page = max(page - 1, 0);
        paged = take(skip(shown, page * 5), 5);
    }

    on Pick(id) { target = id; }
    on SetTarget(v) { target = v; }
    on SetSetpoint(v) { setpoint = v; }

    on Apply {
        outcome = "sending";
        tone = "";
        sending = true;
        sent = await(net.post("api/setpoint", "[\"" + join(map(filter(filter(rows, x => json.get(x, "id", "") == target), x => num(setpoint, 1) == num(setpoint, 2)), x => json.get(x, "id", "")), "") + "\", " + num(setpoint, 0) + "]"));
        sending = false;
        outcome = match sent {
            Ok(reply) => { json.get(reply, "status", "?") + " " + json.get(reply, "body", "") }
            Err(e) => { "not sent: " + e }
            Cancelled => { "cancelled" }
        };
        code = match sent {
            Ok(reply) => { json.get(reply, "status", "x") }
            Err(_) => { "x" }
            Cancelled => { "x" }
        };
        tone = if starts_with(code, "2") { "ok" } else if starts_with(code, "4") { "warn" } else if starts_with(code, "5") || starts_with(code, "x") { "error" } else { "" };
    }

    view {
        Column {
            max_width: 90
            Text { role: heading "Machines" }
            Text { role: status "status: {note}" }
            Button { label: "Refresh" on: Refresh }
            TextField { label: "Search by name" placeholder: "e.g. press" value: q on: Query }
            Button { label: "Sort by temperature, other direction" on: Flip }
            Text { "{len(shown)} of {len(rows)} machines, page {page + 1} of {pages}" }
            Table {
                label: "Machines"
                Row {
                    Text { role: columnheader "id" }
                    Text { role: columnheader "name" }
                    Text { role: columnheader "state" }
                    Text { role: columnheader "temperature (C)" }
                    Text { role: columnheader "select" }
                }
                For {
                    over: paged
                    as: m
                    Row {
                        Text { json.get(m, "id", "?") }
                        Text { json.get(m, "name", "?") }
                        Text { json.get(m, "state", "?") }
                        Text { json.get(m, "temp", "no reading") }
                        Button { label: "Select " + json.get(m, "id", "?") on: Pick(json.get(m, "id", "")) }
                    }
                }
            }
            Row {
                Button { label: "Previous page" on: Prev }
                Button { label: "Next page" on: Next }
            }
            Text { role: heading "Change a setpoint" }
            TextField { label: "Machine id" placeholder: "e.g. M-101" value: target on: SetTarget }
            TextField { label: "Setpoint" placeholder: "degrees C" value: setpoint on: SetSetpoint submit: Apply }
            Button { label: "Apply" on: Apply disabled: sending }
            Text { role: status tone: tone "result: {outcome}" }
        }
    }
}
