// examples/clock/clock.cui — the Tier 4 capability example, as a stopwatch.
// Demonstrates `requires Clock;` + `clock.now()` + `every N Event;`.
// `elapsed` is the stopwatch's reading in milliseconds, 0 until Start.
// Start keeps the reading it had (`started_at` is moved back by it), so
// Stop then Start resumes. While running, `every 100 Tick` recomputes the
// reading from `clock.now()`; the view shows it in seconds (`/` is
// JavaScript division, so 1500 ms shows as 1.5s).

component Clock {
    requires Clock;

    state started_at: Int = 0;
    state elapsed: Int = 0;
    state ticking: Bool = false;

    every 100 Tick;

    on Start {
        if !ticking {
            started_at = clock.now() - elapsed;
            ticking = true;
        }
    }

    on Stop {
        if ticking {
            elapsed = clock.now() - started_at;
            ticking = false;
        }
    }

    on Tick {
        if ticking {
            elapsed = clock.now() - started_at;
        }
    }

    view {
        Column {
            Text {
                role: status
                label: "elapsed time"
                "Elapsed: {elapsed / 1000}s"
            }
            Button { label: "Start" on: Start }
            Button { label: "Stop"  on: Stop  }
        }
    }
}
