// examples/search/search.cui — Tier 9: the proposal §9.3 demo,
// now with the real `Network` capability. Typing drives the
// `query` state field through the `TextField`'s `Change` event;
// `Search` kicks off `net.search(query)`, awaits it, and the
// resolved `Ok(found) | Err(reason) | Cancelled` arms update the
// `results` list. `For` renders one row per result.
//
// The Tier 9 `net.search` stub filters a fixed corpus by
// substring — the demo is fully interactive offline. The three
// outcome arms cover the awaited request completely: a missing
// `Cancelled` arm would be the `match-non-exhaustive` refusal
// because `r` is assigned from `await(...)`.

component Search {
    requires Network;

    state query: String = "";
    state status: String = "idle";
    state r: Result[List[String], String] = Ok([]);
    state results: List[String] = [];

    on Change(value) { query = value; }

    on Submit {
        status = "loading";
        r = await(net.search(query));
        status = match r {
            Ok(_) => { "done" }
            Err(_) => { "error: search failed" }
            Cancelled => { "cancelled" }
        };
        results = match r {
            Ok(found) => { found }
            Err(_) => { [] }
            Cancelled => { [] }
        };
    }

    view {
        Column {
            TextField {
                label: "Search query"
                value: query
                on: Change
            }
            Button { label: "Search" on: Submit }
            Text {
                role: status
                "status: {status}"
            }
            For {
                over: results
                as: n
                Text { "row: {n}" }
            }
        }
    }
}
