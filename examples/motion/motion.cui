// examples/motion/motion.cui — what a page does when an element has been seen (docs/motion.md): `Reveal` shows a block, `CountUp` counts a
// number up, and `visible:` / `hidden:` tell the program by the name of an event. All three are safe by construction: the page's HTML has every
// block, every final number and every section with no script; under reduced motion nothing is hidden and nothing counts; the final number is the
// text of the page the whole time, so a screen reader reads it and not a frame. Replay (`cancho-ui test`) runs `Seen` and `Gone` like any event.

component Landing {
    state seen: Int = 0;
    state gone: Int = 0;

    on Seen { seen = seen + 1; }
    on Gone { gone = gone + 1; }

    view {
        Column {
            Main {
                id: "main"
                Section {
                    id: "top"
                    Heading { level: 1 "Motion" }
                    Rich { "Conformance: " CountUp { to: 704 } " of 704, refusals " CountUp { to: 333 } "." }
                }
                Reveal {
                    Section {
                        id: "one"
                        Heading { level: 2 "One" }
                    Text { "One line 1. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 2. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 3. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 4. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 5. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 6. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 7. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 8. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 9. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 10. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 11. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 12. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 13. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "One line 14. Enough prose that the block takes real room on a phone, and wraps." }
                    }
                }
                Section {
                    id: "watched"
                    visible: Seen
                    hidden: Gone
                    Heading { level: 2 "Watched" }
                    Text { "Watched line 1. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 2. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 3. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 4. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 5. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 6. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 7. Enough prose that the block takes real room on a phone, and wraps." }
                    Text { "Watched line 8. Enough prose that the block takes real room on a phone, and wraps." }
                }
