{
 "program": [
  "component Feed {",
  "    requires Network;",
  "    state link: String = \"\";",
  "    state log: String = \"\";",
  "    subscribe Got \"/stream\" status Link;",
  "    on Got(text) { log = log + text + \"|\"; }",
  "    on Link(word) { link = word; }",
  "    view { Column { Text { \"link={link} log={log}\" } } }",
  "}",
  "",
  "component Page {",
  "    state items: List[String] = [\"feed\"];",
  "    on Remove { items = []; }",
  "    view {",
  "        Column {",
  "            For { over: items as: i Feed { } }",
  "            Button { label: \"Remove\" on: Remove }",
  "        }",
  "    }",
  "}"
 ],
