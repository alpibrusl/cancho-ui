[
  {"why": "numbers ascend numerically, not as text", "keys": [10, 9, 100, 1], "expect": [3, 1, 0, 2]},
  {"why": "strings ascend by code unit", "keys": ["b", "a", "B", "A"], "expect": [3, 2, 1, 0]},
  {"why": "numbers come before strings", "keys": ["a", 5, "b", -1], "expect": [3, 1, 0, 2]},
  {"why": "equal keys keep their order (stable)", "keys": [2, 1, 2, 1, 2], "expect": [1, 3, 0, 2, 4]},
  {"why": "the empty list", "keys": [], "expect": []},
  {"why": "one element", "keys": ["x"], "expect": [0]},
  {"why": "NaN sorts after every number", "keys": [{"nan": true}, 3, -3, {"nan": true}, 0], "expect": [2, 4, 1, 0, 3]},
  {"why": "negative zero equals zero", "keys": [0, -0.0, 0], "expect": [0, 1, 2]},
  {"why": "negative and fractional numbers", "keys": [0.5, -0.5, -10, 2.25], "expect": [2, 1, 0, 3]},
  {"why": "a bool or a list key ranks after strings and compares equal to its kind", "keys": [true, "a", [1], 1, false], "expect": [3, 1, 0, 2, 4]},
  {"why": "a null key ranks with the other non-number non-string keys", "keys": [null, "z", 7], "expect": [2, 1, 0]},
  {"why": "UTF-16 order: an astral character sorts before a BMP high one", "keys": ["￿", "😀", "a"], "expect": [2, 1, 0]},
  {"why": "a shorter string sorts before its extension", "keys": ["ab", "a", "", "abc"], "expect": [2, 1, 0, 3]},
  {"why": "digits in strings are text, not numbers", "keys": ["10", "9", "2"], "expect": [0, 2, 1]},
  {"why": "case matters: upper before lower", "keys": ["a", "A", "b", "B"], "expect": [1, 3, 0, 2]}
]
