  {"why": "! of false", "expr": "!f", "expect": true},
  {"why": "!! is the identity", "expr": "!!t", "expect": true},
  {"why": "! of a comparison", "expr": "!(a > 3)", "expect": false},
  {"why": "&& binds tighter than ||: t || f && f", "expr": "t || f && f", "expect": true},
  {"why": "&& binds tighter than || on the left: f && f || t", "expr": "f && f || t", "expect": true},
  {"why": "parentheses override: (t || f) && f", "expr": "(t || f) && f", "expect": false},
  {"why": "! binds tighter than ==: !f == t", "expr": "!f == t", "expect": true},
  {"why": "! binds tighter than ==: !t == f", "expr": "!t == f", "expect": true},
