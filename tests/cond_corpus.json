  {"why": "a string comparison, false", "expr": "s == \"y\" || a == 8", "expect": false},
  {"why": "&& does not evaluate the right when the left is false (division by zero)", "expr": "b != 0 && a / b > 1", "expect": false},
  {"why": "&& evaluates the right when the left is true", "expr": "b != 0 && a / b > 1", "state": {"b": 2}, "expect": true},
  {"why": "|| does not evaluate the right when the left is true", "expr": "b == 0 || a / b > 1", "expect": true},
  {"why": "|| evaluates the right when the left is false", "expr": "b == 0 || a / b > 1", "state": {"b": 2}, "expect": true},
  {"why": "|| evaluates the right when the left is false (and it is false)", "expr": "b == 0 || a / b > 100", "state": {"b": 2}, "expect": false},
