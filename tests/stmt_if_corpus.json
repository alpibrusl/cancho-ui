  {
    "why": "a block is written once and run by two handlers, and runs another block",
    "source": [
      "component A {",
      "    requires Network;",
      "    state r: Result[String, String] = Ok(\"\");",
      "    state rows: String = \"-\";",
      "    state loads: Int = 0;",
      "    state who: String = \"\";",
      "    block Count { loads = loads + 1; }",
      "    block Load {",
      "        run Count;",
      "        r = await(net.get(\"q/orders\"));",
      "        rows = match r { Ok(t) => { t } Err(_) => { rows } Cancelled => { rows } };",
      "    }",
      "    on Start { who = \"start\"; run Load; }",
      "    on Save { who = \"save\"; run Load; run Count; }",
      "    view { Column { Button { label: \"Start\" on: Start } Button { label: \"Save\" on: Save } Text { \"{who} {loads} {rows}\" } } }",
      "}"
    ],
    "initial": [
      "Start",
      "Save",
      "0 -"
    ],
    "steps": [
      {
        "event": "Start",
        "label": "Start",
        "issued": [
          "q/orders"
        ],
        "state": {
          "who": "start",
          "loads": 1
        },
        "texts": [
          "Start",
          "Save",
          "start 1 -"
        ]
      },
      {
        "resolve": 1,
        "answer": {
          "status": 200,
          "body": "A"
        },
        "issued": [],
        "state": {
          "rows": "A",
          "loads": 1
        },
        "texts": [
          "Start",
          "Save",
          "start 1 A"
        ]
      },
      {
        "event": "Save",
        "label": "Save",
        "issued": [
          "q/orders"
        ],
        "state": {
          "who": "save",
          "loads": 2
        },
        "texts": [
          "Start",
          "Save",
          "save 2 A"
        ]
      },
      {
        "resolve": 2,
