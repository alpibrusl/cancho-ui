  {
    "why": "ifs nest, with an await in the inner one and a later if that reads what the answer wrote",
    "source": [
      "component A {",
      "    requires Network;",
      "    state a: Bool = true;",
      "    state b: Bool = true;",
      "    state r: Result[String, String] = Ok(\"\");",
      "    state t: String = \"\";",
      "    state out: String = \"\";",
      "    on Go {",
      "        out = \"\";",
      "        if a {",
      "            out = out + \"a\";",
      "            if b {",
      "                r = await(net.get(\"q/inner\"));",
      "                t = match r { Ok(x) => { x } Err(_) => { \"\" } Cancelled => { \"\" } };",
      "                out = out + \"b\";",
      "            } else {",
      "                out = out + \"-\";",
      "            }",
      "            out = out + \"c\";",
      "        } else if len(t) > 0 {",
      "            out = out + \"t\";",
      "        } else {",
      "            out = out + \"z\";",
      "        }",
      "        if len(t) > 0 { out = out + \"!\"; }",
      "    }",
      "    on A { a = !a; }",
      "    on B { b = !b; }",
      "    view { Column { Button { label: \"Go\" on: Go } Button { label: \"A\" on: A } Button { label: \"B\" on: B } Text { \"out={out}\" } } }",
      "}"
    ],
    "initial": [
      "Go",
      "A",
      "B",
      "out="
    ],
    "steps": [
      {
        "event": "Go",
        "label": "Go",
        "issued": [
          "q/inner"
        ],
        "state": {
          "out": "a"
        },
        "texts": [
          "Go",
          "A",
          "B",
          "out=a"
        ]
      },
      {
        "resolve": 1,
        "answer": {
          "status": 200,
          "body": "x"
        },
        "issued": [],
        "state": {
          "out": "abc!",
          "t": "x"
        },
        "texts": [
          "Go",
          "A",
          "B",
          "out=abc!"
        ]
      },
      {
        "event": "B",
        "label": "B",
        "issued": [],
        "state": {
          "b": false
        },
        "texts": [
          "Go",
          "A",
          "B",
          "out=abc!"
        ]
      },
      {
        "event": "Go",
        "label": "Go",
        "issued": [],
        "state": {
          "out": "a-c!"
        },
        "texts": [
          "Go",
          "A",
          "B",
          "out=a-c!"
        ]
      },
      {
        "event": "A",
        "label": "A",
        "issued": [],
        "state": {
          "a": false
        },
        "texts": [
          "Go",
          "A",
          "B",
          "out=a-c!"
        ]
      },
      {
        "event": "Go",
