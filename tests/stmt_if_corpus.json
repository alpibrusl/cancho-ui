  {
    "why": "a fault inside a branch undoes the writes since the last commit point, in both evaluators",
    "source": [
      "component A {",
      "    state n: Int = 0;",
      "    state z: Int = 0;",
      "    state big: Int = 0;",
      "    state on_: Bool = true;",
      "    on Go {",
      "        n = n + 1;",
      "        if on_ {",
      "            big = 7;",
      "            big = big / z;",
      "        }",
      "        n = n + 100;",
      "    }",
      "    on Heal { z = 1; }",
      "    view { Column { Button { label: \"Go\" on: Go } Button { label: \"Heal\" on: Heal } Text { \"n={n} big={big}\" } } }",
      "}"
    ],
    "initial": [
      "Go",
      "Heal",
      "n=0 big=0"
    ],
    "steps": [
      {
        "event": "Go",
        "label": "Go",
        "fault": "replay-non-finite",
        "issued": [],
        "state": {
          "n": 0,
          "big": 0
        },
        "texts": [
          "Go",
          "Heal",
          "n=0 big=0"
        ]
      },
      {
        "event": "Heal",
        "label": "Heal",
        "issued": [],
        "state": {
          "z": 1
        },
        "texts": [
          "Go",
          "Heal",
          "n=0 big=0"
        ]
      },
      {
        "event": "Go",
        "label": "Go",
        "issued": [],
        "state": {
          "n": 101,
          "big": 7
        },
        "texts": [
          "Go",
          "Heal",
          "n=101 big=7"
        ]
      }
    ]
  },
  {
    "why": "a fault after an await inside a branch undoes only the writes since that await: the segment before it was committed when the handler suspended",
    "source": [
      "component A {",
      "    requires Network;",
      "    state n: Int = 0;",
      "    state m: Int = 0;",
      "    state z: Int = 0;",
      "    state big: Int = 0;",
      "    state r: Result[String, String] = Ok(\"\");",
      "    on Go {",
      "        n = n + 1;",
      "        if true {",
      "            m = m + 1;",
      "            r = await(net.get(\"q/c\"));",
      "            m = m + 10;",
      "            big = 1 / z;",
      "        }",
      "    }",
      "    on Heal { z = 1; }",
      "    view { Column { Button { label: \"Go\" on: Go } Button { label: \"Heal\" on: Heal } Text { \"n={n} m={m} big={big}\" } } }",
      "}"
    ],
    "initial": [
      "Go",
      "Heal",
      "n=0 m=0 big=0"
    ],
    "steps": [
      {
        "event": "Go",
        "label": "Go",
        "issued": [
          "q/c"
        ],
        "state": {
          "n": 1,
          "m": 1
        },
        "texts": [
          "Go",
          "Heal",
          "n=1 m=1 big=0"
        ]
      },
      {
        "resolve": 1,
