[
  {
    "why": "a request inside an if is issued only when the condition holds; the statements after the if run either way",
    "source": [
      "component A {",
      "    requires Network;",
      "    state ok: Bool = true;",
      "    state n: Int = 0;",
      "    state r: Result[String, String] = Ok(\"\");",
      "    state got: String = \"none\";",
      "    on Go {",
      "        n = n + 1;",
      "        if ok {",
      "            r = await(net.get(\"q/one\"));",
      "            got = match r { Ok(t) => { t } Err(e) => { \"err \" + e } Cancelled => { \"cancelled\" } };",
      "        } else {",
      "            got = \"skipped\";",
      "        }",
      "        n = n + 10;",
      "    }",
      "    on Flip { ok = !ok; }",
      "    view { Column { Button { label: \"Go\" on: Go } Button { label: \"Flip\" on: Flip } Text { \"n={n} got={got}\" } } }",
      "}"
    ],
    "initial": [
      "Go",
      "Flip",
      "n=0 got=none"
    ],
    "steps": [
      {
        "event": "Go",
        "label": "Go",
        "issued": [
          "q/one"
        ],
        "state": {
          "n": 1
        },
        "texts": [
          "Go",
          "Flip",
          "n=1 got=none"
        ]
      },
      {
        "resolve": 1,
        "answer": {
          "status": 200,
          "body": "hello"
        },
        "issued": [],
        "state": {
          "n": 11,
          "got": "hello"
        },
        "texts": [
          "Go",
          "Flip",
          "n=11 got=hello"
        ]
      },
      {
        "event": "Flip",
        "label": "Flip",
        "issued": [],
        "state": {
          "ok": false
        },
        "texts": [
          "Go",
          "Flip",
          "n=11 got=hello"
        ]
      },
      {
        "event": "Go",
        "label": "Go",
        "issued": [],
        "state": {
          "n": 22,
          "got": "skipped"
        },
        "texts": [
          "Go",
          "Flip",
          "n=22 got=skipped"
        ]
      },
      {
        "event": "Flip",
        "label": "Flip",
        "issued": [],
        "state": {
          "ok": true
        },
        "texts": [
          "Go",
          "Flip",
          "n=22 got=skipped"
        ]
      },
      {
        "event": "Go",
        "label": "Go",
        "issued": [
          "q/one"
        ],
        "state": {
          "n": 23
        },
        "texts": [
          "Go",
          "Flip",
          "n=23 got=skipped"
        ]
      },
      {
        "resolve": 2,
        "answer": {
          "status": 500,
          "body": ""
        },
        "issued": [],
        "state": {
          "n": 33,
          "got": "err HTTP 500"
        },
        "texts": [
          "Go",
          "Flip",
          "n=33 got=err HTTP 500"
        ]
      }
    ]
  },
  {
    "why": "a second request depends on the answer to the first: the orders are not asked for after a failed sign-in",
    "source": [
      "component A {",
      "    requires Network;",
      "    state who: String = \"\";",
      "    state first: Result[String, String] = Ok(\"\");",
      "    state second: Result[String, String] = Ok(\"\");",
      "    state signed: Bool = false;",
      "    state msg: String = \"\";",
      "    state rows: String = \"-\";",
      "    on SignIn {",
      "        msg = \"\";",
      "        first = await(net.get(\"q/login\"));",
      "        signed = match first { Ok(t) => { t == \"yes\" } Err(_) => { false } Cancelled => { false } };",
      "        msg = if signed { \"in\" } else { \"refused\" };",
      "        if signed {",
      "            second = await(net.get(\"q/orders\"));",
      "            rows = match second { Ok(t) => { t } Err(e) => { \"err \" + e } Cancelled => { \"cancelled\" } };",
      "        }",
      "    }",
      "    view { Column { Button { label: \"Sign in\" on: SignIn } Text { \"{msg} rows={rows}\" } } }",
      "}"
    ],
    "initial": [
      "Sign in",
      "rows=-"
    ],
    "steps": [
      {
        "event": "SignIn",
        "label": "Sign in",
        "issued": [
          "q/login"
        ],
        "state": {
          "msg": ""
        },
        "texts": [
          "Sign in",
          "rows=-"
        ]
      },
      {
        "resolve": 1,
        "answer": {
          "status": 200,
          "body": "no"
        },
        "issued": [],
        "state": {
          "signed": false,
          "msg": "refused",
          "rows": "-"
        },
        "texts": [
          "Sign in",
          "refused rows=-"
        ]
      },
      {
        "event": "SignIn",
        "label": "Sign in",
        "issued": [
          "q/login"
        ],
        "state": {
          "msg": ""
        },
        "texts": [
          "Sign in",
          "rows=-"
        ]
      },
      {
        "resolve": 2,
        "answer": {
          "status": 200,
          "body": "yes"
        },
        "issued": [
          "q/orders"
        ],
        "state": {
          "signed": true,
          "msg": "in",
          "rows": "-"
        },
        "texts": [
          "Sign in",
          "in rows=-"
        ]
      },
      {
        "resolve": 3,
        "answer": {
          "status": 200,
          "body": "T-1"
        },
        "issued": [],
        "state": {
          "rows": "T-1"
        },
        "texts": [
          "Sign in",
          "in rows=T-1"
        ]
      }
    ]
