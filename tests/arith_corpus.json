[
  {"op": "+", "a": 1, "b": 2, "expect": 3, "why": "an integer sum"},
  {"op": "+", "a": 0.1, "b": 0.2, "expect": 0.30000000000000004, "why": "IEEE doubles: both evaluators round alike"},
  {"op": "+", "a": -0.0, "b": -0.0, "expect": -0.0, "why": "the sign of zero is kept"},
  {"op": "+", "a": 0.0, "b": -0.0, "expect": 0.0, "why": "0 + -0 is 0"},
  {"op": "+", "a": 1.7976931348623157e308, "b": 1.7976931348623157e308, "expect": "fault", "why": "an overflow is not a number"},
  {"op": "+", "a": -1.7976931348623157e308, "b": -1.7976931348623157e308, "expect": "fault", "why": "an overflow below"},
  {"op": "-", "a": 5, "b": 7, "expect": -2, "why": "a negative difference"},
  {"op": "-", "a": 0.0, "b": 0.0, "expect": 0.0, "why": "0 - 0 is 0"},
  {"op": "-", "a": -0.0, "b": 0.0, "expect": -0.0, "why": "-0 - 0 is -0"},
  {"op": "-", "a": -1.7976931348623157e308, "b": 1.7976931348623157e308, "expect": "fault", "why": "an overflow by subtraction"},
  {"op": "*", "a": 6, "b": 7, "expect": 42, "why": "a product"},
  {"op": "*", "a": 0.0, "b": -1, "expect": -0.0, "why": "0 * -1 is -0"},
  {"op": "*", "a": 1e200, "b": 1e200, "expect": "fault", "why": "an overflow by product"},
  {"op": "*", "a": 1e-200, "b": 1e-200, "expect": 0.0, "why": "an underflow is zero, which is a number"},
  {"op": "/", "a": 5, "b": 2, "expect": 2.5, "why": "a quotient"},
  {"op": "/", "a": 0, "b": 5, "expect": 0.0, "why": "zero over a number"},
  {"op": "/", "a": 0.0, "b": -5, "expect": -0.0, "why": "zero over a negative is -0"},
  {"op": "/", "a": 1, "b": 0, "expect": "fault", "why": "division by zero (JavaScript: Infinity)"},
  {"op": "/", "a": -1, "b": 0, "expect": "fault", "why": "division of a negative by zero (JavaScript: -Infinity)"},
  {"op": "/", "a": 1, "b": -0.0, "expect": "fault", "why": "division by negative zero"},
  {"op": "/", "a": 0, "b": 0, "expect": "fault", "why": "zero over zero (JavaScript: NaN)"},
  {"op": "/", "a": 1e308, "b": 1e-308, "expect": "fault", "why": "a quotient that overflows"}
]
