   "why": "a plain text file",
   "name": "hello.txt",
   "type": "text/plain",
   "hex": "68656c6c6f",
   "value": "{\"name\":\"hello.txt\",\"size\":5,\"type\":\"text/plain\",\"text\":\"hello\"}"
