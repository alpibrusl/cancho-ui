{
 "program": [
  "component U {",
  "    state last: String = \"\";",
  "    state count: Int = 0;",
  "    state bumps: Int = 0;",
  "    on Picked(f) { last = f; count = count + 1; }",
  "    on Bump { bumps = bumps + 1; }",
  "    view {",
  "        Column {",
  "            FileField { label: \"Report\" accept: \".txt,text/csv\" max_bytes: 20 on: Picked }",
  "            Button { label: \"Bump\" on: Bump }",
  "            Text { \"picked={count} bumps={bumps}\" }",
  "            Text { \"last={last}\" }",
  "        }",
  "    }",
  "}"
 ],
 "steps": [
