[
  {"why": "lines: one record per line", "op": "lines", "args": ["a\nb\nc"], "expect": ["a", "b", "c"]},
  {"why": "lines: a trailing newline adds no empty line", "op": "lines", "args": ["a\nb\n"], "expect": ["a", "b"]},
  {"why": "lines: the empty text has no lines", "op": "lines", "args": [""], "expect": []},
  {"why": "lines: a lone newline is one empty line", "op": "lines", "args": ["\n"], "expect": [""]},
  {"why": "lines: empty lines in the middle are kept", "op": "lines", "args": ["a\n\nb\n"], "expect": ["a", "", "b"]},
  {"why": "lines: two trailing newlines are one empty line", "op": "lines", "args": ["a\n\n"], "expect": ["a", ""]},
  {"why": "lines: CRLF is one line break", "op": "lines", "args": ["a\r\nb\r\n"], "expect": ["a", "b"]},
  {"why": "lines: a lone CR is removed from the end of its line only", "op": "lines", "args": ["a\rb\nc\r"], "expect": ["a\rb", "c"]},
  {"why": "lines: only one CR is removed", "op": "lines", "args": ["a\r\r\n"], "expect": ["a\r"]},
  {"why": "lines: a lone CR is one empty line", "op": "lines", "args": ["\r"], "expect": [""]},
  {"why": "lines: spaces are kept", "op": "lines", "args": [" a \n b "], "expect": [" a ", " b "]},
  {"why": "lines: non-ASCII text is kept", "op": "lines", "args": ["é\n😀\n"], "expect": ["é", "😀"]},
  {"why": "lines: the bound, 10005 lines become 10000", "op": "lines", "args": [{"repeat": ["x\n", 10005]}], "expect_len": 10000},
  {"why": "lines: exactly 10000 lines are all kept", "op": "lines", "args": [{"repeat": ["x\n", 10000]}], "expect_len": 10000},
  {"why": "lines: 9999 lines are all kept", "op": "lines", "args": [{"repeat": ["x\n", 9999]}], "expect_len": 9999},
  {"why": "split: a separator", "op": "split", "args": ["a,b,c", ","], "expect": ["a", "b", "c"]},
  {"why": "split: empty pieces are kept", "op": "split", "args": ["a,,b,", ","], "expect": ["a", "", "b", ""]},
  {"why": "split: the empty text is one empty piece", "op": "split", "args": ["", ","], "expect": [""]},
  {"why": "split: no occurrence", "op": "split", "args": ["abc", ","], "expect": ["abc"]},
  {"why": "split: the empty separator does not split", "op": "split", "args": ["abc", ""], "expect": ["abc"]},
  {"why": "split: the empty text and the empty separator", "op": "split", "args": ["", ""], "expect": [""]},
  {"why": "split: a separator of several characters", "op": "split", "args": ["a::b::c", "::"], "expect": ["a", "b", "c"]},
  {"why": "split: occurrences do not overlap, left to right", "op": "split", "args": ["aaa", "aa"], "expect": ["", "a"]},
  {"why": "split: the whole text is the separator", "op": "split", "args": [",", ","], "expect": ["", ""]},
  {"why": "split: case matters", "op": "split", "args": ["aXbxc", "x"], "expect": ["aXb", "c"]},
  {"why": "split: the bound, 10005 pieces become 10000", "op": "split", "args": [{"repeat": ["x,", 10004]}, ","], "expect_len": 10000},
  {"why": "join: strings", "op": "join", "args": [["a", "b", "c"], ", "], "expect": "a, b, c"},
  {"why": "join: the empty list", "op": "join", "args": [[], ","], "expect": ""},
  {"why": "join: one element has no separator", "op": "join", "args": [["a"], ","], "expect": "a"},
  {"why": "join: empty strings", "op": "join", "args": [["", ""], "-"], "expect": "-"},
  {"why": "join: the empty separator", "op": "join", "args": [["a", "b"], ""], "expect": "ab"},
  {"why": "trim: both ends", "op": "trim", "args": ["  a b  "], "expect": "a b"},
  {"why": "trim: tab, newline, CR, form feed, vertical tab", "op": "trim", "args": ["\t\n\r\f\u000bx\u000b\f\r\n\t"], "expect": "x"},
  {"why": "trim: nothing to trim", "op": "trim", "args": ["abc"], "expect": "abc"},
  {"why": "trim: only white space", "op": "trim", "args": [" \t\n"], "expect": ""},
  {"why": "trim: the empty text", "op": "trim", "args": [""], "expect": ""},
  {"why": "trim: a no-break space is not ASCII white space", "op": "trim", "args": [" a "], "expect": " a "},
  {"why": "trim: a byte order mark is not ASCII white space", "op": "trim", "args": ["﻿a"], "expect": "﻿a"},
  {"why": "trim: an ideographic space is not ASCII white space", "op": "trim", "args": ["　a　"], "expect": "　a　"},
  {"why": "trim: inner white space is kept", "op": "trim", "args": [" a  b "], "expect": "a  b"},
  {"why": "upper: ASCII", "op": "upper", "args": ["abcXYZ019"], "expect": "ABCXYZ019"},
  {"why": "upper: only ASCII letters change", "op": "upper", "args": ["éßı"], "expect": "éßı"},
  {"why": "upper: the empty text", "op": "upper", "args": [""], "expect": ""},
  {"why": "starts_with: a prefix", "op": "starts_with", "args": ["abc", "ab"], "expect": true},
  {"why": "starts_with: not a prefix", "op": "starts_with", "args": ["abc", "bc"], "expect": false},
  {"why": "starts_with: the empty prefix", "op": "starts_with", "args": ["abc", ""], "expect": true},
  {"why": "starts_with: the empty text and the empty prefix", "op": "starts_with", "args": ["", ""], "expect": true},
  {"why": "starts_with: a prefix longer than the text", "op": "starts_with", "args": ["a", "ab"], "expect": false},
  {"why": "starts_with: case matters", "op": "starts_with", "args": ["abc", "AB"], "expect": false},
  {"why": "starts_with: the whole text", "op": "starts_with", "args": ["abc", "abc"], "expect": true},
  {"why": "ends_with: a suffix", "op": "ends_with", "args": ["abc", "bc"], "expect": true},
  {"why": "ends_with: not a suffix", "op": "ends_with", "args": ["abc", "ab"], "expect": false},
  {"why": "ends_with: the empty suffix", "op": "ends_with", "args": ["abc", ""], "expect": true},
  {"why": "ends_with: the empty text and the empty suffix", "op": "ends_with", "args": ["", ""], "expect": true},
  {"why": "ends_with: a suffix longer than the text", "op": "ends_with", "args": ["c", "bc"], "expect": false},
  {"why": "ends_with: case matters", "op": "ends_with", "args": ["abc", "BC"], "expect": false},
  {"why": "ends_with: the whole text", "op": "ends_with", "args": ["abc", "abc"], "expect": true},
  {"why": "ends_with: a repeated suffix is found at the end", "op": "ends_with", "args": ["abab", "ab"], "expect": true}
]
