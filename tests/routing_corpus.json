{
 "program": [
  "component R {",
  "    requires Router;",
  "    state path: String = \"/\";",
  "    state log: String = \"\";",
  "    state target: String = \"\";",
  "    state ok: Bool = false;",
  "    state flag: Bool = false;",
  "    route Heard;",
  "    on Heard(p) {",
  "        path = p;",
  "        log = log + p + \";\";",
  "        if p == \"/old\" { flag = router.replace(\"/new\"); }",
  "    }",
  "    on SetTarget(v) { target = v; }",
  "    on Go { ok = router.go(target); }",
  "    on Replace { ok = router.replace(target); }",
  "    on Two { ok = router.go(\"/p1\"); flag = router.go(\"/p2\"); }",
  "    view {",
  "        Column {",
  "            TextField { label: \"Target\" value: target on: SetTarget }",
  "            Button { label: \"Go\" on: Go }",
  "            Button { label: \"Replace\" on: Replace }",
  "            Button { label: \"Two\" on: Two }",
  "            NavLink { label: \"To b\" to: \"/b?q=1\" }",
  "            NavLink { label: \"Home\" to: \"/\" }",
  "            NavLink { label: \"Old\" to: \"/old\" }",
  "            NavLink { label: \"Odd\" to: \"/odd/%7E(x)\" }",
  "            Text { \"path=[{path}] log={log} ok={ok}\" }",
  "        }",
  "    }",
  "}"
 ],
 "load": "/start",
 "links": {
  "To b": "/b?q=1",
  "Home": "/",
  "Old": "/old",
  "Odd": "/odd/%7E(x)"
 },
 "steps": [
  {
   "why": "the page loaded at a deep link: the route event heard it",
   "do": "load",
   "heard": [
    "/start"
   ],
   "log": "/start;",
   "path": "/start",
   "hash": "#/start"
  },
  {
   "why": "a link is a real anchor: following it is a new entry and a route event",
   "do": "click",
   "arg": "To b",
   "heard": [
    "/b?q=1"
   ],
   "log": "/start;/b?q=1;",
   "path": "/b?q=1",
   "hash": "#/b?q=1",
   "grew": 1
  },
  {
   "why": "the same link again: the fragment does not change, nothing fires",
   "do": "click",
   "arg": "To b",
   "heard": [],
   "log": "/start;/b?q=1;",
   "path": "/b?q=1",
   "hash": "#/b?q=1",
   "grew": 0
  },
  {
