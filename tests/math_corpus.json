  {"op": "max", "args": [-0.0, -0.0], "expect": -0.0, "why": "max(-0, -0) is -0"},
  {"op": "max", "args": ["NaN", 1], "expect": "NaN", "why": "NaN on the left"},
  {"op": "max", "args": [1, "NaN"], "expect": "NaN", "why": "NaN on the right"},
  {"op": "max", "args": ["Infinity", 1], "expect": "Infinity", "why": "Infinity is largest"},
