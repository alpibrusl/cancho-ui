# cancho-ui build output (lands with Phase 1)
/target
/build
/dist
*.o
*.a
*.so
*.dylib
*.out
*.js
# the project page serves this one: it is the compiler's output for examples/counter (tested in tests/cli.rs)
!docs/demo/counter.js
# the gallery demos are served as they are: each page needs its script (docs/mobile-backend.md section 5.2)
!docs/demo/*/app.js
# the device probe is a hand-written static page: its scripts are the page (docs/mobile-backend.md section 8.1)
!docs/probe/*.js
!scripts/*.js
# the scripts of the sealed islands are the program's files, pinned by hash (docs/islands.md)
!examples/islands/assets/*.js
!tests/fixtures/islands/*.js
*.js.map
*.cui.bak

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode from measurement scripts (lands with Phase 3)
__pycache__/
*.pyc

# Core dumps: trap tests end programs by signal
core
core.[0-9]*